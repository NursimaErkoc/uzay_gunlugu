# Bu dosya bir ÖRNEKTİR ve GitHub'a gider.
# Kopyasını ".env" adıyla oluştur ve gerçek değerleri oraya yaz (.env GitHub'a gitmez).

# https://api.nasa.gov adresinden ücretsiz alınır. Almadan önce DEMO_KEY ile de deneyebilirsin.
NASA_API_KEY=DEMO_KEY

# --- E-posta hatırlatmaları (Gmail) ---
# Gmail adresin
GMAIL_ADRESI=ornek@gmail.com
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama şifreleri  (16 harf, normal şifren DEĞİL)
GMAIL_UYGULAMA_SIFRESI=abcd efgh ijkl mnop
# Hatırlatmalar kime gitsin? Boş bırakırsan GMAIL_ADRESI'ne gider.
HATIRLATMA_ALICISI=
# E-postadaki linkler için sitenin adresi
SITE_ADRESI=http://127.0.0.1:8000

# --- Sadece internette (Render) gerekenler; bilgisayarında boş bırak ---
# Çeviri: Render'da Google engelleniyor. DeepL (deepl.com > ücretsiz API hesabı > API Keys) ana çeviri servisi.
# Boş bırakırsan Google, o da olmazsa MyMemory denenir.
DEEPL_API_KEY=
# Render'da Google çevirisi engelleniyor; yedek çeviri servisi MyMemory'nin kotası bu adrese bağlanır.
MYMEMORY_EPOSTA=
# Render ücretsiz planı Gmail SMTP'yi engeller; orada e-posta Resend API ile gider.
# resend.com'da HATIRLATMA ALICISI ile AYNI e-posta adresiyle hesap aç > API Keys > Create.
RESEND_API_KEY=
# Neon'dan alınan PostgreSQL adresi. Boşsa SQLite (uzay_gunlugu.db) kullanılır.
DATABASE_URL=
# Hatırlatma kurmak/silmek için yönetici anahtarı (uzun, tahmin edilemez bir metin). Boşsa kontrol yok.
YONETICI_ANAHTARI=
