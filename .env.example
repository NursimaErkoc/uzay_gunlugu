# Bu dosya bir ÖRNEKTİR ve GitHub'a gider.
# Kopyasını ".env" adıyla oluştur ve gerçek değerleri oraya yaz (.env GitHub'a gitmez).

# https://api.nasa.gov adresinden ücretsiz alınır. Almadan önce DEMO_KEY ile de deneyebilirsin.
NASA_API_KEY=DEMO_KEY

# --- E-posta hatırlatmaları (Gmail) ---
# Gmail adresin
GMAIL_ADRESI=ornek@gmail.com
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama şifreleri  (16 harf, normal şifren DEĞİL)
GMAIL_UYGULAMA_SIFRESI=abcd efgh ijkl mnop
# Hatırlatmalar kime gitsin? Boş bırakırsan GMAIL_ADRESI'ne gider.
HATIRLATMA_ALICISI=
# E-postadaki linkler için sitenin adresi
SITE_ADRESI=http://127.0.0.1:8000
